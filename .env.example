# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CBC Mail Service API Configuration
# Endpoint de l'API Mail Service CBC (local ou réseau interne)
CBC_MAIL_API_ENDPOINT="http://lumen-mail-service.test"
# Clé API pour l'authentification Mail Service CBC (NE PAS COMMITTER EN PRODUCTION)
CBC_MAIL_API_KEY="YOUR_CBC_MAIL_API_KEY_HERE"

# Supervision des services système (paramétrable)
# Activer la supervision des services
SERVICES_MONITORING_ENABLED="false"
# Liste JSON des services à superviser (ex: ["SWIFT AutoClient", "SQL Server"])
SERVICES_MONITORING_LIST="[]"
# Intervalle de vérification en secondes
SERVICES_MONITORING_INTERVAL="60"

# Supervision des fichiers (paramétrable)
# Activer la supervision des fichiers
FILES_MONITORING_ENABLED="false"
# Liste JSON des fichiers à superviser (ex: [{"path": "/var/log/swift.log", "max_size_mb": 100}])
FILES_MONITORING_LIST="[]"
# Intervalle de vérification en secondes
FILES_MONITORING_INTERVAL="300"
