# Sentinel — configuration du serveur, environnement de TEST (172.16.4.38).
#
# À copier en « .env » dans le dossier du serveur, puis à compléter.
# Ce fichier ne doit jamais retourner dans le dépôt : il porte le mot de
# passe de la base et la clé de signature des jetons.

# --- Base de données -------------------------------------------------------
# Le rôle, la base et le mot de passe créés en phase 2.
DATABASE_URL=postgresql://cbc_user:A_REMPLACER@localhost:5432/cbc_supervision

# --- Signature des jetons de session ---------------------------------------
# Au moins 32 caractères, propres à CETTE machine. Le script d'installation
# en génère un ; ne pas reprendre celui d'un autre environnement, sinon un
# jeton émis ailleurs serait accepté ici.
SECRET_KEY=A_GENERER
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cache Redis -----------------------------------------------------------
# Le Redis fourni par Laragon. Sentinel n'envoie aucun mot de passe : Redis
# DOIT donc rester lié à 127.0.0.1 (voir redis.windows.conf, directive
# « bind »). Un Redis sans authentification joignable sur le réseau permet
# d'écrire des fichiers sur l'hôte via CONFIG SET.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Télémétrie longue durée -----------------------------------------------
# Laissées vides : les intégrations se désactivent d'elles-mêmes et les
# métriques restent dans PostgreSQL. À renseigner le jour où l'historique
# long devient un besoin.
VICTORIA_METRICS_URL=
LOKI_URL=

# --- Seuils et cadence -----------------------------------------------------
# 180 s : au-delà, un hôte est déclaré hors ligne. La cadence de battement
# des agents est plafonnée aux deux tiers de cette valeur.
HEARTBEAT_TIMEOUT_SECONDS=180
CPU_WARNING_THRESHOLD=80.0
CPU_CRITICAL_THRESHOLD=95.0
RAM_WARNING_THRESHOLD=80.0
RAM_CRITICAL_THRESHOLD=95.0
DISK_WARNING_THRESHOLD=85.0
DISK_CRITICAL_THRESHOLD=95.0

# --- Enrôlement ------------------------------------------------------------
# Jeton d'amorçage réutilisable : pratique pour équiper un pilote de dix
# machines sans repasser par l'écran des jetons. À RETIRER avant que cet
# environnement ne devienne une production — en production, chaque jeton est
# émis par un administrateur et ne sert qu'une fois.
BOOTSTRAP_ENROLLMENT_TOKEN=
BOOTSTRAP_TOKEN_REUSABLE=false

# --- Annuaire (LDAP) -------------------------------------------------------
# Désactivé au départ : on valide d'abord la chaîne avec des comptes locaux.
LDAP_ENABLED=false
LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
