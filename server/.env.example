# Configuration de la base de données
DATABASE_URL=postgresql://cbc_user:cbc_password@localhost:5432/cbc_supervision

# Configuration SSL/TLS
SSL_CERTFILE=ssl/cert.pem
SSL_KEYFILE=ssl/key.pem

# Configuration de sécurité
SECRET_KEY=your-secret-key-change-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Configuration de l'application
APP_NAME=CBC Supervision Platform
APP_VERSION=1.0.0

# Self-hosted metrics (VictoriaMetrics) — no signup
VICTORIA_METRICS_URL=http://localhost:8428
LOKI_URL=http://localhost:3100

# Configuration du heartbeat
HEARTBEAT_TIMEOUT_SECONDS=180
OFFLINE_ALERT_THRESHOLD_SECONDS=90

# Seuils d'alerte par défaut
CPU_WARNING_THRESHOLD=80.0
CPU_CRITICAL_THRESHOLD=95.0
RAM_WARNING_THRESHOLD=80.0
RAM_CRITICAL_THRESHOLD=95.0
DISK_WARNING_THRESHOLD=85.0
DISK_CRITICAL_THRESHOLD=95.0

# Configuration email (optionnel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_TO=

# ============================================================================
# ANNUAIRE D'ENTREPRISE — LDAP / ACTIVE DIRECTORY (API-003)
# ============================================================================
# Désactivé par défaut. Tant que LDAP_ENABLED=false, seuls les comptes locaux
# sont utilisables et aucune de ces variables n'est lue.
#
# À RENSEIGNER PAR CBC : URI du contrôleur de domaine, compte de service en
# lecture seule, base de recherche et DN des groupes.
#
# Vérification avant activation pour les utilisateurs :
#   1. POST /api/settings/ldap/test        -> joignabilité + bind du service
#   2. POST /api/settings/ldap/probe-user  -> filtre + rôle résolu
#   (ou Paramètres -> Annuaire (LDAP) dans le tableau de bord)

LDAP_ENABLED=false

# ldaps://… en production. ldap://… n'est acceptable qu'avec LDAP_START_TLS=true.
LDAP_SERVER_URI=

# Compte de service en LECTURE SEULE, utilisé pour rechercher les comptes
# avant le bind d'authentification. Ne jamais utiliser un compte privilégié.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

LDAP_USER_SEARCH_BASE=

# {username} est remplacé par la saisie, échappée selon la RFC 4515.
# Active Directory : (&(objectClass=user)(sAMAccountName={username}))
# OpenLDAP        : (&(objectClass=person)(uid={username}))
LDAP_USER_FILTER=(&(objectClass=person)(uid={username}))

# Attributs. Sur Active Directory : sAMAccountName / mail / displayName / memberOf
LDAP_ATTR_USERNAME=uid
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_DISPLAY_NAME=cn
LDAP_ATTR_MEMBER_OF=memberOf

# Correspondance groupe -> rôle, en JSON. Le PREMIER groupe correspondant
# l'emporte : placer les rôles les plus privilégiés en tête.
# Rôles valides : admin | operator | security | read_only
# Exemple :
# LDAP_ROLE_MAPPING={"CN=Sentinel-Admins,OU=Groupes,DC=cbc,DC=cm":"admin","CN=Sentinel-SOC,OU=Groupes,DC=cbc,DC=cm":"operator","CN=Sentinel-Audit,OU=Groupes,DC=cbc,DC=cm":"security"}
LDAP_ROLE_MAPPING={}

# Rôle attribué quand aucun groupe ne correspond. Volontairement le moins
# privilégié : un compte d'annuaire ne doit pas obtenir de droits par défaut.
# Rôle attribué à un compte d'annuaire lors de sa PREMIÈRE connexion, quand
# aucune correspondance ne s'applique. Ce n'est qu'une amorce : les rôles se
# gèrent ensuite dans l'application (écran Utilisateurs), et une connexion
# ultérieure ne les réécrit jamais. Garder read_only ici est le choix sûr —
# un nouveau venu n'obtient aucun droit tant qu'un administrateur ne le
# décide pas.
LDAP_DEFAULT_ROLE=read_only

LDAP_USE_SSL=true
LDAP_START_TLS=false
# Ne passer à false que pour un annuaire de test à certificat auto-signé.
LDAP_TLS_VERIFY=true
LDAP_CA_CERT_FILE=
LDAP_TIMEOUT_SECONDS=5

# Conserver true : sans repli local, une panne d'annuaire ferme l'accès à la
# plateforme, y compris à l'administrateur de secours.
LDAP_ALLOW_LOCAL_FALLBACK=true
